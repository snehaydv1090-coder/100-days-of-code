#include <stdio.h>

int main() {
    int arr[100], n, k, i, j, last;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    // Read array elements
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter number of positions to rotate: ");
    scanf("%d", &k);

    k = k % n;

    // Rotate k times
    for (i = 0; i < k; i++) {

        last = arr[n - 1];

        // Shift elements to the right
        for (j = n - 1; j > 0; j--) {
            arr[j] = arr[j - 1];
        }

        arr[0] = last;
    }

    // Print rotated array
    printf("Array after rotation: ");

    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
