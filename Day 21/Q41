#include <stdio.h>

int main() {
    int num, first, last, temp, divisor = 1, result;

    printf("Enter a number: ");
    scanf("%d", &num);

    temp = num;
    last = num % 10;

    // Find divisor for the first digit
    while (temp >= 10) {
        temp = temp / 10;
        divisor = divisor * 10;
    }

    first = temp;

    // Swap first and last digits
    result = num - (first * divisor) - last
             + (last * divisor) + first;

    printf("Number after swapping = %d\n", result);

    return 0;
}
