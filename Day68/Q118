#include <stdio.h>

int main() {
    int arr[100];
    int n, i;
    int expectedSum, actualSum = 0;
    int missing;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        actualSum = actualSum + arr[i];
    }

    expectedSum = n * (n + 1) / 2;

    missing = expectedSum - actualSum;

    printf("Missing number = %d\n", missing);

    return 0;
}
