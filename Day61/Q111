#include <stdio.h>

int main() {
    int arr[100];
    int n, k, i, j;
    int firstNegative;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter value of k: ");
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("Invalid value of k\n");
        return 0;
    }

    for (i = 0; i <= n - k; i++) {

        firstNegative = 0;

        for (j = i; j < i + k; j++) {
            if (arr[j] < 0) {
                firstNegative = arr[j];
                break;
            }
        }

        printf("%d ", firstNegative);
    }

    return 0;
}
